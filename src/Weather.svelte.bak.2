<script lang="ts">
  import { onMount, onDestroy } from 'svelte';
  import { slide } from 'svelte/transition';
  import { sineIn } from 'svelte/easing';
  import Rainfall from './Rainfall.svelte';
  import Snowfall from './Snowfall.svelte';
  import Thunderstorm from './Thunderstorm.svelte';

  // OpenWeatherMap API 키
  const apiKey = '0d32f254e4c2763f35c5b05a76f3a76e';
  // 서울의 위도와 경도
  const lat = 37.5665;
  const lon = 126.978;

  let weatherData: any = null;
  let errorMessage: string = '';
  let currentFoodIndex = 0;
  let intervalId: any;
  let isDay = new Date().getHours() >= 6 && new Date().getHours() < 18;

  const weatherConditions = {
    Clear: {
      day: { icon: '☀️', overlay: 'overlay-clear-day' },
      night: { icon: '🌙', overlay: 'overlay-clear-night' },
      food: { preText: '맑은 날엔 ', items: ['신선한 샐러드', '과일 스무디', '가벼운 샌드위치'], postText: '로 상쾌함을 더하세요.' }
    },
    Clouds: {
      day: { icon: '☁️', overlay: 'overlay-clouds-day' },
      night: { icon: '☁️', overlay: 'overlay-clouds-night' },
      food: { preText: '구름 낀 날엔 ', items: ['따뜻한 라떼', '크림 파스타', '허브티'], postText: '와 함께.' }
    },
    Rain: {
      day: { icon: '🌧️', overlay: 'overlay-rain' },
      night: { icon: '🌧️', overlay: 'overlay-rain' },
      food: { preText: '비 오는 날엔 ', items: ['파전', '칼국수', '김치전'], postText: '이 최고죠!'}
    },
    Drizzle: {
      day: { icon: '🌦️', overlay: 'overlay-rain' },
      night: { icon: '🌦️', overlay: 'overlay-rain' },
      food: { preText: '이슬비 내리는 날엔 ', items: ['바나나 팬케이크', '바나나 스무디', '초코 바나나 토스트'], postText: ' 어때요?'}
    },
    Snow: {
      day: { icon: '❄️', overlay: 'overlay-snow-day' },
      night: { icon: '❄️', overlay: 'overlay-snow-night' },
      food: { preText: '눈 오는 날엔 ', items: ['따끈한 어묵탕', '달콤한 호떡', '김이 나는 찐빵'], postText: '으로 몸을 녹여보세요.' }
    },
    Thunderstorm: {
      day: { icon: '⚡️', overlay: 'overlay-thunderstorm' },
      night: { icon: '⚡️', overlay: 'overlay-thunderstorm' },
      food: { preText: '번개 치는 날엔 ', items: ['매운 짬뽕', '따끈한 부대찌개', '치킨에 맥주'], postText: ' 한 잔!'}
    },
    Default: {
      day: { icon: '🤔', overlay: 'overlay-default' },
      night: { icon: '🤔', overlay: 'overlay-default' },
      food: { preText: '오늘 날씨엔 ', items: ['든든한 국밥', '매콤한 떡볶이', '샌드위치'], postText: '이 좋겠네요.'}
    },
  };

  async function getWeatherData() {
    try {
      const response = await fetch(`https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric&lang=kr`);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      weatherData = await response.json();
      startFoodTransition();
    } catch (error) {
      errorMessage = `날씨 정보를 가져오는 데 실패했습니다: ${error.message}`;
      console.error(errorMessage);
    }
  }

  function startFoodTransition() {
    if (intervalId) clearInterval(intervalId);
    intervalId = setInterval(() => {
      currentFoodIndex = (currentFoodIndex + 1) % (getWeatherConditionData().food.items.length || 1);
    }, 4000);
  }

  function getWeatherConditionData() {
    const condition = weatherData?.weather[0]?.main || 'Default';
    return weatherConditions[condition] || weatherConditions.Default;
  }

  onMount(getWeatherData);
  onDestroy(() => {
    if (intervalId) clearInterval(intervalId);
  });

  $: conditionData = getWeatherConditionData();
  $: timeOfDay = isDay ? 'day' : 'night';
  $: foodItems = conditionData.food.items;
  $: preText = conditionData.food.preText;
  $: postText = conditionData.food.postText;
</script>

<div class="weather-container">
  {#if errorMessage}
    <p class="error-message">{errorMessage}</p>
  {:else if weatherData}
    <!-- Dynamic Weather Effects -->
    {#if weatherData.weather[0].main === 'Rain' || weatherData.weather[0].main === 'Drizzle'}
      <Rainfall />
    {/if}
    {#if weatherData.weather[0].main === 'Snow'}
      <Snowfall />
    {/if}
    {#if weatherData.weather[0].main === 'Thunderstorm'}
      <Thunderstorm />
    {/if}

    <!-- Weather Overlay -->
    <div class="overlay-base {conditionData[timeOfDay].overlay}"></div>
    
    <!-- Weather Info -->
    <div class="weather-content">
      <h1 class="location-text">Seoul</h1>
      <div class="temperature-container">
        <span class="weather-icon">{conditionData[timeOfDay].icon}</span>
        <h2 class="temperature-text">{Math.round(weatherData.main.temp)}°C</h2>
      </div>
      <p class="weather-description">{weatherData.weather[0].description}</p>
      
      <!-- Details Panel -->
      <div class="details-panel">
        <div class="detail-item">
          <span class="detail-icon">💧</span>
          <span>{weatherData.main.humidity}%</span>
        </div>
        <div class="detail-item">
          <span class="detail-icon">🌡️</span>
          <span>{Math.round(weatherData.main.feels_like)}°C</span>
        </div>
        <div class="detail-item">
          <span class="detail-icon">💨</span>
          <span>{weatherData.wind.speed.toFixed(1)}m/s</span>
        </div>
      </div>

      <!-- Food Recommendation -->
      <div class="food-recommendation">
        {#key currentFoodIndex}
          <div class="food-text-wrapper" in:slide={{ duration: 1200, easing: sineIn, axis: 'y' }} out:slide={{ duration: 1200, easing: sineIn, axis: 'y' }}>
            <span class="food-item">
              {preText}<span class="highlight">{foodItems[currentFoodIndex]}</span>{postText}
            </span>
          </div>
        {/key}
      </div>
    </div>
  {:else}
    <div class="loading-container">
      <div class="banana-loader"></div>
      <p>오늘의 날씨와 AI 추천 메뉴를<br>불러오는 중...</p>
    </div>
  {/if}
</div>

