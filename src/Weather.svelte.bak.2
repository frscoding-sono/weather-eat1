    position: relative;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    color: white;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
    overflow: hidden;
  }
  .weather-content {
    position: relative;
    z-index: 20; 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(0,0,0,0.3);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
  }

  /* Typography */
  .location-text { font-size: 4rem; font-weight: 300; letter-spacing: 2px; margin-bottom: 0.5rem; }
  .temperature-container { display: flex; align-items: center; justify-content: center; margin-bottom: 0.5rem; }
  .weather-icon { font-size: 5rem; margin-right: 1.5rem; }
  .temperature-text { font-size: 6rem; font-weight: 700; }
  .weather-description { font-size: 1.5rem; font-weight: 400; text-transform: capitalize; }
  
  /* Details Panel */
  .details-panel { display: flex; justify-content: space-around; width: 100%; max-width: 400px; margin-top: 2rem; padding: 1rem; background: rgba(0,0,0,0.2); border-radius: 15px; }
  .detail-item { display: flex; flex-direction: column; align-items: center; font-size: 1.2rem; }
  .detail-icon { font-size: 2rem; margin-bottom: 0.5rem; }

  /* Food Recommendation */
  .food-recommendation { margin-top: 2rem; min-height: 2.5em; display: flex; align-items: center; justify-content: center; width: 100%;}
  .highlight { color: #FFD700; }
  .food-text-wrapper {
    position: relative;
    width: 100%;
    height: 1.5em; /* Match font-size */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .food-item {
    position: absolute;
    white-space: nowrap;
    font-size: 1.5rem;
    font-weight: 800;
    text-shadow: 
      0px 1px 2px rgba(255, 255, 255, 0.3),
      0px -1px 2px rgba(0, 0, 0, 0.6),
      0 0 5px rgba(0, 0, 0, 0.8),
      0 0 20px rgba(192, 228, 255, 0.4);
  }

  /* Overlay Styles */
  .overlay-base { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; transition: background-color 1.2s ease, backdrop-filter 1.2s ease; position: absolute; top: 0; left: 0; z-index: 15; }
  .overlay-clear-day { background-color: rgba(60, 160, 255, 0.2); backdrop-filter: brightness(1.1); }
  .overlay-clear-night { background-color: rgba(10, 20, 60, 0.3); backdrop-filter: brightness(0.7); }
  .overlay-clouds-day { background-color: rgba(150, 160, 170, 0.4); backdrop-filter: brightness(0.9); }
  .overlay-clouds-night { background-color: rgba(50, 60, 70, 0.5); backdrop-filter: brightness(0.6); }
  .overlay-rain { background-color: rgba(70, 80, 90, 0.6); backdrop-filter: brightness(0.7) saturate(0.8); }
  .overlay-snow-day { background-color: rgba(220, 230, 240, 0.5); backdrop-filter: brightness(1.0) saturate(0.9); }
  .overlay-snow-night { background-color: rgba(30, 40, 60, 0.4); backdrop-filter: brightness(0.7) saturate(0.9); }
  .overlay-thunderstorm { background-color: rgba(40, 20, 60, 0.7); backdrop-filter: brightness(0.6) contrast(1.2); }
  .overlay-default { background-color: rgba(100, 100, 100, 0.3); }

  /* Loading and Error */
  .loading-container, .error-message { text-align: center; font-size: 1.5rem; }
  .banana-loader {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #FFD700;
    margin: 0 auto 1rem;
    animation: bounce 1.2s ease-in-out infinite;
  }
  @keyframes bounce { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-20px) scale(1.1); } }
</style>